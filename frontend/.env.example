# Python AAIS API (existing default)
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_URL=http://127.0.0.1:8000

# Sovereign Assistant live telemetry WebSocket (optional; off until enabled in UI or env)
# Prefer explicit URL with {sessionId} placeholder, or derive from REST base + path:
# VITE_AAIS_WS_ENABLED=1
# VITE_AAIS_WS_URL=ws://127.0.0.1:8000/ws/chat/{sessionId}
# VITE_AAIS_WS_PATH=/ws/chat/{sessionId}
# Set VITE_AAIS_WS_ENABLED=0 to force-disable even if URL is set.

# Set to 1 after `npx ampx generate outputs --out-dir src` from deploy/amplify/
# Requires frontend/src/amplify_outputs.json (gitignored; copy from amplify_outputs.json.example)
# Enables /auth/sign-in and gates /operator/* + /platform/* behind Cognito
# VITE_AMPLIFY_AUTH=1
